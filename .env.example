# Copy to `.env` at the repository root (git-ignored).
# Values match infra/compose/compose.yaml: local development only, never reuse them elsewhere.

# development | test | staging | production. Unset means production.
APP_ENV=development

DATABASE_URL=postgres://epilove:epilove@localhost:5432/epilove
VALKEY_URL=redis://localhost:6379

CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_HTTP_API_KEY=dev-only-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-only-centrifugo-token-secret

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=epilove
S3_SECRET_ACCESS_KEY=epilove-dev-secret
S3_BUCKET=epilove-media

IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=6465762d6f6e6c792d696d6770726f78792d6b6579
IMGPROXY_SALT=6465762d6f6e6c792d696d6770726f78792d73616c74

# Mailpit catches every email: http://localhost:8025
SMTP_URL=smtp://localhost:1025

# Application-level encryption (message bodies, report details): id:base64(32 bytes), comma-separated.
ENCRYPTION_KEYS=dev2026:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
ENCRYPTION_CURRENT_KEY_ID=dev2026
# HMAC secret for email fingerprints (hidden contacts, secret crushes, waiting list). Never changes once data exists.
EMAIL_HMAC_SECRET=dev-only-email-hmac-secret-at-least-32-chars

# Development only: trust the `x-dev-user-id` header as the signed-in member. Refused unless APP_ENV is development or test.
DEV_AUTH=1

# Session A
EMAIL_FROM=Epilove <no-reply@epilove.local>
APP_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3001
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32+
PASSKEY_RP_ID=localhost
# Cloudflare Turnstile: leave empty in development to disable the challenge.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Client IP for per-IP rate limits: headers to read (most trusted first) and trusted reverse-proxy ranges.
AUTH_IP_HEADERS=x-forwarded-for
AUTH_TRUSTED_PROXIES=
# Object storage endpoint reachable by browsers, when it differs from S3_ENDPOINT. S3_REGION defaults to "auto" (R2).
S3_PUBLIC_ENDPOINT=
S3_REGION=
# Back-office (apps/admin, port 3001): its own sessions and cookie.
ADMIN_URL=http://localhost:3001
# Public origin of the site, used in waiting list referral links (<SITE_URL>/?r=<code>).
SITE_URL=http://localhost:3000
# Forge ID (EPITA's OpenID Connect provider, ONB-11): leave empty to disable.
FORGE_ID_DISCOVERY_URL=
FORGE_ID_CLIENT_ID=
FORGE_ID_CLIENT_SECRET=
FORGE_ID_CAMPUS_CLAIM=campus
FORGE_ID_CAMPUS_VALUE=lyon
FORGE_ID_GRADUATION_CLAIM=
NEXT_PUBLIC_FORGE_ID_ENABLED=
# Microsoft sign-in (ONB-10, exploration, ADR 0013): leave empty to disable.
# Comma-separated directory (tenant) ids of the schools; without them the provider stays off.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_ALLOWED_TENANTS=
NEXT_PUBLIC_MICROSOFT_ENABLED=
# Client IP headers for the API's per-address limit (most trusted first).
API_IP_HEADERS=x-forwarded-for
# Session B
# WebSocket URL of Centrifugo as seen by browsers (derived from CENTRIFUGO_URL when unset).
# CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
# Web Push (VAPID). Development-only key pair: production keys live in the secret manager.
VAPID_PUBLIC_KEY=BCOdoeex0kO37rvKiyzmhYMzzeFKQGSeRO9K_F0fZu0fc0ANczFLiKEV6wkj--NScRLhzAZK43y54_F4AumBi_s
VAPID_PRIVATE_KEY=C4dXvMJrzZBtEZtTZ09GF77mvS2U0cQZsj1kzJfeMSQ
VAPID_SUBJECT=mailto:dev@epilove.invalid
# The weekly e-mail digest (NOT-05) uses SMTP_URL, EMAIL_FROM and APP_URL above.
# AI conversation starters (CHAT-04): off unless both are set (and then only for members who consent).
# AI_ICEBREAKERS_ENABLED=1
# ANTHROPIC_API_KEY=
