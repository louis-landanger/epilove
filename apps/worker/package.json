{
  "name": "@epilove/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs and scheduled tasks (Graphile Worker on PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@epilove/core": "workspace:*",
    "@epilove/db": "workspace:*",
    "@epilove/media": "workspace:*",
    "drizzle-orm": "catalog:",
    "graphile-worker": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@epilove/config": "workspace:*",
    "@types/node": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
