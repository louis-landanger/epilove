{
  "name": "@epilove/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs and scheduled tasks (Graphile Worker on PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "drop:run": "tsx --env-file-if-exists=../../.env src/tasks/drop/cli.ts",
    "pact:compute": "tsx --env-file-if-exists=../../.env src/tasks/pact/cli.ts compute",
    "pact:demo": "tsx --env-file-if-exists=../../.env src/tasks/pact/cli.ts demo",
    "pact:load": "tsx --env-file-if-exists=../../.env src/tasks/pact/cli.ts load"
  },
  "dependencies": {
    "@epilove/core": "workspace:*",
    "@epilove/db": "workspace:*",
    "@epilove/notifications": "workspace:*",
    "@epilove/realtime": "workspace:*",
    "graphile-worker": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@epilove/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
