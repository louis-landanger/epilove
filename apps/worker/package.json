{
  "name": "@atomes/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs and scheduled tasks (Graphile Worker on PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "drop:run": "tsx --env-file-if-exists=../../.env src/tasks/drop/cli.ts",
    "pact:compute": "tsx --env-file-if-exists=../../.env src/tasks/pact/cli.ts compute",
    "pact:demo": "tsx --env-file-if-exists=../../.env src/tasks/pact/cli.ts demo",
    "pact:load": "tsx --env-file-if-exists=../../.env src/tasks/pact/cli.ts load"
  },
  "dependencies": {
    "@atomes/core": "workspace:*",
    "@atomes/db": "workspace:*",
    "@atomes/email": "workspace:*",
    "@atomes/media": "workspace:*",
    "@atomes/notifications": "workspace:*",
    "@atomes/realtime": "workspace:*",
    "drizzle-orm": "catalog:",
    "fflate": "catalog:",
    "graphile-worker": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@atomes/config": "workspace:*",
    "@types/node": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
