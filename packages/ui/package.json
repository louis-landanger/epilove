{
  "name": "@epilove/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system: accessible primitives and app components built on Base UI, Tailwind CSS and the design tokens.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./cn": "./src/cn.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./app/*": "./src/app/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static --quiet",
    "test:visual": "pnpm build-storybook && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@epilove/tokens": "workspace:*",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@epilove/config": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
