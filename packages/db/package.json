{
  "name": "@atomes/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations and seeds (Drizzle ORM).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./repositories/*": "./src/repositories/*.ts",
    "./dev-seed": "./src/dev-seed/seed.ts",
    "./testing": "./src/testing/fixtures.ts",
    "./storage": "./src/storage/object-store.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:promote": "tsx --env-file-if-exists=../../.env src/promote.ts",
    "db:seed:dev": "tsx --env-file-if-exists=../../.env src/dev-seed/index.ts"
  },
  "dependencies": {
    "@atomes/core": "workspace:*",
    "@atomes/crypto": "workspace:*",
    "@atomes/realtime": "workspace:*",
    "aws4fetch": "catalog:",
    "drizzle-orm": "catalog:",
    "graphile-worker": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@atomes/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
