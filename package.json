{
  "name": "epilove",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "services:up": "docker compose -f infra/compose/compose.yaml up -d --wait",
    "services:down": "docker compose -f infra/compose/compose.yaml down",
    "services:reset": "docker compose -f infra/compose/compose.yaml down --volumes",
    "db:generate": "pnpm --filter @epilove/db db:generate",
    "db:migrate": "pnpm --filter @epilove/db db:migrate",
    "db:seed": "pnpm --filter @epilove/db db:seed",
    "db:seed:dev": "pnpm --filter @epilove/db db:seed:dev",
    "pact:compute": "pnpm --filter @epilove/worker pact:compute",
    "pact:demo": "pnpm --filter @epilove/worker pact:demo",
    "drop:run": "pnpm --filter @epilove/worker drop:run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.15",
    "turbo": "2.11.6",
    "typescript": "7.0.2"
  }
}
