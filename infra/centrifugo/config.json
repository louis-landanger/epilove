{
  "client": {
    "allowed_origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3100",
      "http://127.0.0.1:3100"
    ]
  },
  "health": {
    "enabled": true
  },
  "channel": {
    "namespaces": [
      {
        "name": "personal",
        "allow_user_limited_channels": true,
        "history_size": 100,
        "history_ttl": "300s",
        "force_recovery": true,
        "presence": true
      },
      {
        "name": "broadcast",
        "allow_subscribe_for_client": true,
        "presence": true
      }
    ]
  }
}
